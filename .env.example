# Postgres 14+ with the btree_gist extension available (Neon, Supabase, Render all have it).
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/mezbaan"
# 32+ random characters. Signs staff sign-in cookies. Required in production.
AUTH_SECRET=""
# Public address of the app, used in guest links (manage booking, waiting list).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional: protects /api/cron/tick. The scheduler sends "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""
# Optional: WhatsApp Cloud API. Without these, messages are queued for staff to send in one tap.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE="mezbaan_guest_update"
WHATSAPP_TEMPLATE_LANG="en"
